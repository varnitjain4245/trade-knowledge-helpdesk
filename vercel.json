{
  "services": {
    "trade-knowledge-helpdesk": {
      "root": "backend",
      "entrypoint": "app/demo/main.py",
      "buildCommand": "pip install -r requirements.txt"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": { "type": "service", "service": "trade-knowledge-helpdesk" }
    }
  ]
}
